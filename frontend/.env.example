# The API (backend/). Several addresses may be listed, comma-separated: the
# one on the same host as the page is used, else the first.
VITE_API_BASE_URL=http://localhost:8210/api
VITE_APP_NAME="POS"

# Money on screen and on receipts: an ISO 4217 code and a BCP 47 locale
# (target market: Philippines → PHP + en-PH; e.g. EUR + de-DE elsewhere). Baked in at build time like the others.
VITE_CURRENCY=PHP
VITE_LOCALE=en-PH

# ── Docker (docker-compose.yml) ─────────────────────────────────────
APP_SLUG=pos
WEB_DEV_PORT=5210
WEB_PORT=3210
