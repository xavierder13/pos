import axios from '../../api/axiosInstance';

// {{Titles}} — backend {{Model}}Controller (`/{{kebabs}}`, generated by make:module). REST; 422 = field errors.
// {{Title}} = { id, name, description, active, created_at, updated_at }
// - getAll({ page, per_page, search, active, sort, order }) → { data: [{{Title}}], meta: { current_page, per_page, total } }   ({{kebab}}-list)
// - getById(id) → { data: {{Title}} }                    ({{kebab}}-list | {{kebab}}-edit)
// - create({ name, description, active }) → 201 { data } ({{kebab}}-create)
// - update(id, same) → { data }                          ({{kebab}}-edit)
// - remove(id) → { message }                             ({{kebab}}-delete)
const {{model}}Api = {
  getAll:  (params)      => axios.get('/{{kebabs}}', { params }),
  getById: (id)          => axios.get(`/{{kebabs}}/${id}`),
  create:  (payload)     => axios.post('/{{kebabs}}', payload),
  update:  (id, payload) => axios.put(`/{{kebabs}}/${id}`, payload),
  remove:  (id)          => axios.delete(`/{{kebabs}}/${id}`),
};

export default {{model}}Api;
