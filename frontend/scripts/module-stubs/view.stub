// src/pages/{{folder}}/{{Model}}View.jsx — /{{kebabs}}/:id, one {{title}} read only + its history (generated by make:module).

import { useCallback, useEffect, useState } from 'react';
import { useNavigate, useParams } from 'react-router-dom';
import { App, Button, Col, Popconfirm, Row, Spin, Tag } from 'antd';
import { DeleteOutlined, EditOutlined } from '@ant-design/icons';
import ViewHeader from '../../components/ViewHeader';
import ViewSection from '../../components/ViewSection';
import AuditHistory from '../../components/AuditHistory';
import Attachments from '../../components/Attachments';
import ApprovalPanel from '../../components/approvals/ApprovalPanel';
import RecordNotFound from '../../components/RecordNotFound';
import useAuth from '../../hooks/useAuth';
import {{model}}Api from '../../services/{{folder}}/{{model}}Api';
import handleApiError from '../../utils/handleApiError';
import { formatDateTime } from '../../utils/formatDate';
import {{Model}}FormModal from './{{Model}}FormModal';

const LIST_PATH = '/{{kebabs}}';

const {{Model}}View = () => {
  const { id } = useParams();
  const navigate = useNavigate();
  const { message } = App.useApp();
  const { can } = useAuth();
  const [record, setRecord] = useState(null);
  const [state, setState] = useState('loading');   // loading | ready | missing
  const [editing, setEditing] = useState(false);

  const load = useCallback(async () => {
    try {
      const { data } = await {{model}}Api.getById(id);
      setRecord(data.data);
      setState('ready');
    } catch (error) {
      if (error.response?.status !== 404) handleApiError(error, message);
      setState((s) => (s === 'loading' ? 'missing' : s));
    }
  }, [id, message]);

  useEffect(() => {
    const run = async () => { await load(); };
    run();
  }, [load]);

  const remove = async () => {
    try {
      const { data } = await {{model}}Api.remove(record.id);
      message.success(data.message);
      navigate(LIST_PATH);
    } catch (error) {
      handleApiError(error, message);
    }
  };

  if (state === 'loading') return <Spin size="large" style={{ display: 'block', margin: '80px auto' }} />;
  if (state === 'missing') return <RecordNotFound title="{{Title}} not found" backTo={LIST_PATH} />;

  return (
    <>
      <ViewHeader
        backTo={LIST_PATH}
        title={record.name}
        tags={<Tag color={record.active ? 'green' : 'default'}>{record.active ? 'Active' : 'Inactive'}</Tag>}
        subtitle={`{{Title}} #${record.id}`}
        extra={<>
          {can('{{kebab}}-edit') && <Button type="primary" icon={<EditOutlined />} onClick={() => setEditing(true)}>Edit</Button>}
          {can('{{kebab}}-delete') && (
            <Popconfirm title="Delete this {{title}}?" description={record.name} okText="Delete" okButtonProps={{ danger: true }} onConfirm={remove}>
              <Button danger icon={<DeleteOutlined />}>Delete</Button>
            </Popconfirm>
          )}
        </>}
      />

      <Row gutter={[16, 16]}>
        <Col xs={24} xl={12}>
          <ViewSection title="Details" items={[
            ['Name', record.name],
            ['Description', record.description],
            ['Status', <Tag key="s" color={record.active ? 'green' : 'default'}>{record.active ? 'Active' : 'Inactive'}</Tag>],
          ]} />
        </Col>
        <Col xs={24} xl={12}>
          <ViewSection title="Record" items={[
            ['Created', formatDateTime(record.created_at)],
            ['Last updated', formatDateTime(record.updated_at)],
          ]} />
        </Col>
        <Col xs={24} xl={12}>
          <Attachments type="{{kebab}}" recordId={record.id} />
        </Col>
        <Col xs={24} xl={12}>
          <ApprovalPanel type="{{kebab}}" recordId={record.id} />
        </Col>
        <Col xs={24}>
          <AuditHistory record="{{Title}}" recordId={record.id} />
        </Col>
      </Row>

      <{{Model}}FormModal record={editing ? record : null} onClose={() => setEditing(false)}
        onSaved={() => { setEditing(false); load(); }} />
    </>
  );
};

export default {{Model}}View;
