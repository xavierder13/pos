// src/store/{{model}}Store.js — {{Titles}}: paged / filtered / sorted server-side (generated by make:module).

import { create } from 'zustand';
import {{model}}Api from '../services/{{folder}}/{{model}}Api';

export const DEFAULT_{{CONST}}_PARAMS = { page: 1, per_page: 20, search: '', active: undefined, sort: undefined, order: undefined };

const use{{Model}}Store = create((set, get) => ({

  // ── State ──────────────────────────────────────────
  items:     [],
  total:     0,
  params:    DEFAULT_{{CONST}}_PARAMS,
  isLoading: false,
  error:     null,

  // ── Actions ────────────────────────────────────────
  fetchItems: async (changes = {}) => {
    const params = { ...get().params, ...changes };
    set({ params, isLoading: true, error: null });
    try {
      const { data } = await {{model}}Api.getAll(params);
      set({ items: data.data, total: data.meta.total });
    } catch (error) {
      set({ error: error.response?.data?.message || 'Failed to load {{titles}}.' });
    } finally {
      set({ isLoading: false });
    }
  },

}));

export default use{{Model}}Store;
