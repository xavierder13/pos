// src/pages/{{folder}}/{{Model}}Index.jsx — {{Titles}} list (generated by make:module).

import { useState } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { App, Button, Input, Popconfirm, Select, Space, Table, Tag, Tooltip } from 'antd';
import { PlusOutlined, ReloadOutlined } from '@ant-design/icons';
import ActionButton from '../../components/ActionButton';
import PageHeader from '../../components/PageHeader';
import useAuth from '../../hooks/useAuth';
import use{{Models}} from '../../hooks/use{{Models}}';
import {{model}}Api from '../../services/{{folder}}/{{model}}Api';
import handleApiError from '../../utils/handleApiError';
import { formatDateTime } from '../../utils/formatDate';
import {{Model}}FormModal from './{{Model}}FormModal';

const SORT_ORDER = { asc: 'ascend', desc: 'descend' };

const {{Model}}Index = () => {
  const { message } = App.useApp();
  const navigate = useNavigate();
  const { can } = useAuth();
  const canCreate = can('{{kebab}}-create');
  const canEdit = can('{{kebab}}-edit');
  const canDelete = can('{{kebab}}-delete');
  const { items, total, params, isLoading, fetchItems } = use{{Models}}();
  const [editing, setEditing] = useState(null);   // null = closed, {} = add, a record = edit

  const remove = async (record) => {
    try {
      const { data } = await {{model}}Api.remove(record.id);
      message.success(data.message);
      fetchItems(items.length === 1 && params.page > 1 ? { page: params.page - 1 } : {});
    } catch (error) {
      handleApiError(error, message);
    }
  };

  const sortOrder = (key) => (params.sort === key ? SORT_ORDER[params.order] : null);

  const columns = [
    {
      title: 'Name', dataIndex: 'name', key: 'name', sorter: true, sortOrder: sortOrder('name'),
      render: (name, record) => <Link to={`/{{kebabs}}/${record.id}`}>{name}</Link>,
    },
    { title: 'Description', dataIndex: 'description', key: 'description', ellipsis: true, render: (v) => v || '—' },
    {
      title: 'Status', dataIndex: 'active', key: 'active', width: 110, sorter: true, sortOrder: sortOrder('active'),
      render: (active) => <Tag color={active ? 'green' : 'default'}>{active ? 'Active' : 'Inactive'}</Tag>,
    },
    { title: 'Created', dataIndex: 'created_at', key: 'created_at', width: 190, sorter: true, sortOrder: sortOrder('created_at'), render: formatDateTime },
    {
      title: 'Actions', key: 'actions', width: 130,
      render: (_, record) => (
        <Space size={6}>
          <ActionButton kind="view" onClick={() => navigate(`/{{kebabs}}/${record.id}`)} />
          {canEdit && <ActionButton kind="edit" onClick={() => setEditing(record)} />}
          {canDelete && (
            <Popconfirm title="Delete this {{title}}?" description={record.name} okText="Delete" okButtonProps={{ danger: true }} onConfirm={() => remove(record)}>
              <ActionButton kind="delete" />
            </Popconfirm>
          )}
        </Space>
      ),
    },
  ];

  const onTableChange = (pagination, _filters, sorter) => {
    const order = sorter?.order ? (sorter.order === 'ascend' ? 'asc' : 'desc') : undefined;
    fetchItems({ page: pagination.current, per_page: pagination.pageSize, sort: order ? sorter.columnKey : undefined, order });
  };

  return (
    <>
      <PageHeader title="{{Titles}}" extra={canCreate && (
        <Button type="primary" icon={<PlusOutlined />} onClick={() => setEditing({})}>Add {{Title}}</Button>
      )} />

      <Space wrap style={{ marginBottom: 16 }}>
        <Input.Search placeholder="Search {{titles}}" allowClear style={{ width: 260 }}
          defaultValue={params.search} onSearch={(search) => fetchItems({ search, page: 1 })} />
        <Select placeholder="Status" allowClear style={{ width: 140 }} value={params.active}
          options={[{ value: 1, label: 'Active' }, { value: 0, label: 'Inactive' }]}
          onChange={(active) => fetchItems({ active, page: 1 })} />
        <Tooltip title="Reload"><Button icon={<ReloadOutlined />} onClick={() => fetchItems()} /></Tooltip>
      </Space>

      <Table rowKey="id" columns={columns} dataSource={items} loading={isLoading} onChange={onTableChange} scroll={{ x: 800 }}
        pagination={{ current: params.page, pageSize: params.per_page, total, showTotal: (n) => `${n} {{title}}${n === 1 ? '' : 's'}` }} />

      <{{Model}}FormModal record={editing} onClose={() => setEditing(null)} onSaved={() => { setEditing(null); fetchItems(); }} />
    </>
  );
};

export default {{Model}}Index;
