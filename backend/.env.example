APP_NAME="POS API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8210
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Docker (docker-compose.yml) ─────────────────────────────────────
# Prefix of every container / volume name — unique per project
APP_SLUG=pos
# Host ports
NGINX_PORT=8210
PMA_PORT=8211
# Mailpit (development email inbox)
MAILPIT_PORT=8212
DB_FORWARD_PORT=3321
# Your host user (id -u / id -g) so bind-mounted files stay yours
DOCKER_UID=1000
DOCKER_GID=1000

# ── Database (the `db` container) ───────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pos
DB_USERNAME=pos
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── SPA ─────────────────────────────────────────────────────────────
# The SPA's address: links in emails (reset password) point here
FRONTEND_URL=http://localhost:5210
# Comma-separated origins the React app is served from (config/cors.php)
FRONTEND_URLS=http://localhost:5210,http://localhost:3210,http://localhost:8213
# Idle timeout / session duration: Administration → Session Settings (database)

# First admin account (php artisan db:seed) — no default password
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# File attachments (config/attachments.php): disk local | s3, max size, allowed types
ATTACHMENTS_DISK=local
ATTACHMENTS_MAX_KB=10240
ATTACHMENTS_MIMES=pdf,doc,docx,xls,xlsx,csv,txt,jpg,jpeg,png,gif,webp,zip

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Development: every email lands in Mailpit (MAILPIT_PORT). Production: your SMTP server.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
