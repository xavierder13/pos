<?php

namespace App\Http\Requests\{{Models}};

use Illuminate\Foundation\Http\FormRequest;
use Illuminate\Validation\Rule;

// create (POST) and update (PUT) share the rules
class Store{{Model}}Request extends FormRequest
{
    public function authorize(): bool
    {
        return true;   // the route's `permission:` middleware decides
    }

    /**
     * @return array<string, mixed>
     */
    public function rules(): array
    {
        return [
            'name' => ['required', 'string', 'max:255', Rule::unique('{{table}}', 'name')->ignore($this->route('{{model}}'))],
            'description' => ['nullable', 'string', 'max:2000'],
            'active' => ['sometimes', 'boolean'],
        ];
    }
}
