<?php

namespace Database\Seeders;

use App\Support\Rbac;
use Illuminate\Database\Seeder;
use Spatie\Permission\Models\Permission;

// {{Titles}}' permissions (listed in PermissionSeeder::MODULES)
class {{Model}}PermissionSeeder extends Seeder
{
    /**
     * @return array<int, string>
     */
    public static function permissions(): array
    {
        return ['{{kebab}}-list', '{{kebab}}-create', '{{kebab}}-edit', '{{kebab}}-delete'];
    }

    public function run(): void
    {
        foreach (self::permissions() as $name) {
            Permission::firstOrCreate(['name' => $name, 'guard_name' => Rbac::GUARD]);
        }
    }
}
