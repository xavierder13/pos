<?php

namespace Tests\Feature\{{Models}};

use App\Models\{{Model}};
use Tests\Feature\ApiTestCase;

class {{Model}}Test extends ApiTestCase
{
    public function test_list_is_paginated_and_searchable(): void
    {
        $this->actingAsAdmin();
        {{Model}}::factory()->create(['name' => 'Findme Item']);
        {{Model}}::factory()->count(3)->create();

        $this->getJson('/api/{{kebabs}}?search=Findme')->assertOk()->assertJsonPath('meta.total', 1);
    }

    public function test_create_show_update_delete(): void
    {
        $this->actingAsAdmin();

        $id = $this->postJson('/api/{{kebabs}}', ['name' => 'First', 'description' => 'Hello'])
            ->assertCreated()->assertJsonPath('data.name', 'First')->json('data.id');
        $this->getJson("/api/{{kebabs}}/{$id}")->assertOk()->assertJsonPath('data.description', 'Hello');
        $this->putJson("/api/{{kebabs}}/{$id}", ['name' => 'Renamed', 'active' => false])
            ->assertOk()->assertJsonPath('data.active', false);
        $this->deleteJson("/api/{{kebabs}}/{$id}")->assertOk();
        $this->assertDatabaseMissing('{{table}}', ['id' => $id]);
    }

    public function test_validation_and_permissions(): void
    {
        $this->actingAsAdmin();
        $this->postJson('/api/{{kebabs}}', [])->assertStatus(422)->assertJsonValidationErrors('name');

        $this->actingAsUserWith(['{{kebab}}-list']);
        $this->getJson('/api/{{kebabs}}')->assertOk();
        $this->postJson('/api/{{kebabs}}', ['name' => 'Nope'])->assertStatus(403);
    }

    public function test_changes_are_audited(): void
    {
        $this->actingAsAdmin();
        $id = $this->postJson('/api/{{kebabs}}', ['name' => 'Audited'])->json('data.id');

        $this->getJson("/api/audit-trail?record={{Title}}&record_id={$id}")->assertOk()->assertJsonPath('meta.total', 1);
    }
}
