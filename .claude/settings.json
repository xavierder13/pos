{
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make pint)",
      "Bash(make lint)",
      "Bash(make ps)",
      "Bash(make up)",
      "Bash(make seed)",
      "Bash(make artisan *)",
      "Bash(docker compose * exec -T web-dev npm run *)",
      "Bash(docker compose * ps)",
      "Bash(docker compose * logs *)",
      "Bash(bash .claude/skills/verify/scripts/ui-check.sh *)",
      "Bash(git -C backend status*)",
      "Bash(git -C backend diff*)",
      "Bash(git -C backend log*)",
      "Bash(git -C frontend status*)",
      "Bash(git -C frontend diff*)",
      "Bash(git -C frontend log*)"
    ],
    "ask": [
      "Bash(make fresh)",
      "Bash(make module *)",
      "Bash(git * push*)",
      "Bash(git * reset*)"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Read(./frontend/.env)",
      "Read(./backend/.env.*.local)"
    ]
  }
}
